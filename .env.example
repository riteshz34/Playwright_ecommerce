# ============================================================================
#  Playwright E-Commerce Framework - Environment Configuration
#  Copy this file to `.env` and adjust the values:   cp .env.example .env
#  `.env` is git-ignored, so real credentials never reach the repository.
# ============================================================================

# ---------------------------------------------------------------------------
# TARGET ENVIRONMENT
# Which environment block from config/environments.js to load.
# Allowed values: dev | qa | staging | prod
# ---------------------------------------------------------------------------
TEST_ENV=qa

# ---------------------------------------------------------------------------
# APPLICATION UNDER TEST
# Overrides the baseURL that comes from config/environments.js.
# Leave empty to use the URL mapped to TEST_ENV.
# ---------------------------------------------------------------------------
BASE_URL=https://www.saucedemo.com

# ---------------------------------------------------------------------------
# CREDENTIALS (never commit real secrets - use GitHub Actions secrets in CI)
# ---------------------------------------------------------------------------
STANDARD_USER=standard_user
LOCKED_OUT_USER=locked_out_user
PROBLEM_USER=problem_user
PERFORMANCE_USER=performance_glitch_user
INVALID_USER=not_a_real_user
USER_PASSWORD=secret_sauce
INVALID_PASSWORD=wrong_password_123

# ---------------------------------------------------------------------------
# EXECUTION CONTROL
# ---------------------------------------------------------------------------
# Run browsers without a UI window (true in CI, false for local debugging)
HEADLESS=true
# Number of parallel workers. Empty = Playwright decides (50% of CPU cores).
WORKERS=
# Retry count for failed tests
RETRIES=1
# Slow every Playwright action down by N ms - useful when watching a run
SLOW_MO=0
# Default browser project when none is passed on the CLI
BROWSER=chromium

# ---------------------------------------------------------------------------
# TIMEOUTS (milliseconds)
# ---------------------------------------------------------------------------
TEST_TIMEOUT=60000
EXPECT_TIMEOUT=10000
ACTION_TIMEOUT=15000
NAVIGATION_TIMEOUT=30000

# ---------------------------------------------------------------------------
# ARTEFACTS: 'on' | 'off' | 'retain-on-failure' | 'only-on-failure'
# ---------------------------------------------------------------------------
SCREENSHOT_MODE=only-on-failure
VIDEO_MODE=retain-on-failure
TRACE_MODE=retain-on-failure

# ---------------------------------------------------------------------------
# REPORTING
# ---------------------------------------------------------------------------
ALLURE_RESULTS_DIR=allure-results
# Free-text labels that show up in the Allure "Environment" widget
ALLURE_EXECUTOR=local
